// The website on Cloudflare Workers, as static files only (no Worker code):
// the pages built in dist/ by `npm run build`, deployed by `npx wrangler deploy`
// (.github/workflows/deploy.yml does both on every push to master).
{
  "name": "katameros",
  // DCO Cloudflare account, which holds the katameros.app zone
  "account_id": "b95b2c9dd00193a3a8a4dfaebb9f21d6",
  "compatibility_date": "2026-10-30",
  // The site's address: every request for katameros.app goes to this Worker. The zone
  // keeps its proxied DNS record for the name: a route needs one, whatever its target,
  // so that record must not be deleted. (A custom domain was refused: Cloudflare does
  // not replace an existing DNS record, error 100117.)
  // www.katameros.app is not routed: it must only redirect to katameros.app.
  "routes": [
    { "pattern": "katameros.app/*", "zone_name": "katameros.app" }
  ],
  // No second copy of the site on katameros.copte.workers.dev
  "workers_dev": false,
  "preview_urls": false,
  "assets": {
    "directory": "./dist",
    // /fr/about redirects to /fr/about/ (the pages are <path>/index.html);
    // dist/_redirects makes the main pages permanent (scripts/hosting-files.mjs)
    "html_handling": "auto-trailing-slash",
    // Unknown addresses get the nearest 404.html with a 404 status
    "not_found_handling": "404-page"
  }
}
