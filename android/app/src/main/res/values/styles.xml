<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- Base application theme. -->
    <style name="AppTheme" parent="Theme.AppCompat.Light.DarkActionBar">
        <!-- Customize your theme here. -->
        <item name="colorPrimary">@color/colorPrimary</item>
        <item name="colorPrimaryDark">@color/colorPrimaryDark</item>
        <item name="colorAccent">@color/colorAccent</item>
    </style>

    <style name="AppTheme.NoActionBar" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
        <item name="android:background">@null</item>
        <!-- No android:windowOptOutEdgeToEdgeEnforcement here: Android 16
             ignores it for apps targeting SDK 36, and Capacitor reads the
             very same attribute to decide whether adjustMarginsForEdgeToEdge
             should run. Setting it made Capacitor skip the inset margins
             while the system still laid the window out edge-to-edge, so the
             app bar drew under the status bar. Without it the webview is
             margined off the insets and this window background is what shows
             behind the transparent bars. -->
        <item name="android:windowBackground">@drawable/window_background</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">@bool/lightNavigationBar</item>
    </style>


    <style name="AppTheme.NoActionBarLaunch" parent="Theme.SplashScreen">
        <item name="android:background">@drawable/splash</item>
    </style>
</resources>
